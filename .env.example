# Скопируйте в .env (файл не попадает в git) и задайте свои значения.

# Три разных пароля: суперпользователь Postgres, владелец схемы (только Flyway) и роль приложения.
# Роли создаются один раз, при инициализации пустого тома: после смены паролей здесь
# их нужно поменять и в базе (ALTER ROLE) либо пересоздать том.
POSTGRES_PASSWORD=change-me-superuser
DB_MIGRATION_PASSWORD=change-me-owner
DB_PASSWORD=change-me-app

# Адрес сайта: с ним сверяется заголовок Origin. При смене APP_PORT поменяйте порт и здесь.
# В dev-режиме через Vite: http://localhost:5173
SITE_ORIGIN=http://localhost:8080

# false только для http://localhost. На сервере с HTTPS поставьте true.
COOKIE_SECURE=false

# true только за собственным обратным прокси, который сам выставляет X-Forwarded-For.
# TRUST_X_FORWARDED_FOR=false

# Необязательно: порты на хосте, если стандартные заняты.
# APP_PORT=8080
# DB_PORT=5432
